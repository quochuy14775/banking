# Chép file này thành .env.local (không đưa lên git) rồi điền địa chỉ backend.
# Để trống thì app chạy bằng dữ liệu mock (chế độ demo, không cần backend).
# Sửa xong phải tải lại app (reload) thì giá trị mới có hiệu lực.
#
# Địa chỉ auth-service theo nơi chạy app:
#   Trình duyệt trên máy (expo start --web):  http://localhost:9003
#   Máy ảo Android:                           http://10.0.2.2:9003   (localhost của máy ảo không phải máy tính)
#   Điện thoại thật dùng Expo Go:             http://<IP của máy tính trong mạng LAN>:9003
EXPO_PUBLIC_AUTH_API_URL=

# Địa chỉ customer-service (đăng ký bằng CCCD gắn chip + xác thực khuôn mặt), cổng 9001, cùng quy tắc như trên.
# Chạy Expo web thì customer-service phải mở CORS cho http://localhost:8081 (corebank.cors.allowed-origins).
EXPO_PUBLIC_CUSTOMER_API_URL=
