{
  "expo": {
    "name": "VietBank",
    "slug": "MobileBanking",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobilebanking",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F4D3C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F4D3C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "VietBank dùng camera để quét mã QR chuyển tiền, quét mã QR trên CCCD và chụp khuôn mặt khi xác thực eKYC.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "VietBank dùng Face ID để bạn đăng nhập nhanh và an toàn."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VietBank cần truy cập ảnh để đọc mã QR chuyển tiền từ thư viện."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
